---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cited from '../../components/Cited.astro';
import ReadingSheep from '../../components/ReadingSheep.astro';
import { WIKI_CATEGORY, fmtDate, href, stripRefs, wikiHref, type WikiEntry } from '../../lib/mag';
import '../../styles/wiki-articles.css';

export async function getStaticPaths() {
  const entries = await getCollection('wiki');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry, all: entries },
  }));
}

interface Props {
  entry: WikiEntry;
  all: WikiEntry[];
}

const { entry, all } = Astro.props;
const { term, en, aliases, category, oneLiner, senses, body, sources, related, updated } = entry.data;

const bySlug = new Map(all.map((e) => [e.data.slug, e]));
const relatedTerms = related
  .map((slug) => bySlug.get(slug))
  .filter((item): item is WikiEntry => Boolean(item));

const nSources = sources.length;
const indexHref = href('/wiki/');
const pad2 = (n: number) => String(n).padStart(2, '0');

/** 출처 한 줄 — 발행처와 도메인. 발행처가 없거나 도메인을 이미 품고 있으면 한 번만 싣는다. */
const sourceRows = sources.map((source) => {
  const host = new URL(source.url).hostname.replace(/^www\./, '');
  const publisher = source.publisher?.trim();
  const origin = !publisher
    ? host
    : publisher.toLowerCase().includes(host.toLowerCase())
      ? publisher
      : `${publisher} · ${host}`;
  return { ...source, origin };
});

// 양 세기 — 한 줄 정의 + 뜻 갈래 + 본문 문단 + 출처가 읽기 단위다.
const readUnits = 1 + senses.length + body.length + 1;
---

<Base
  title={`${term} — 위키`}
  description={stripRefs(oneLiner)}
  active="wiki"
  ogType="article"
  layout="article"
>
  <article class="wiki-entry" data-pagefind-body>
    <header class="wiki-entry-head" data-article-hero data-reveal>
      <p class="wiki-crumb"><a href={indexHref}>← 위키</a></p>
      <p class="wiki-kicker">{WIKI_CATEGORY[category].ko}</p>
      <h1>
        {term}
        {en && <span lang="en">{en}</span>}
      </h1>
      <p class="wiki-lede" data-read-unit>
        <Cited text={oneLiner} sourceCount={nSources} />
      </p>
      <dl class="wiki-entry-meta">
        <div>
          <dt class="wiki-meta-key">기준일</dt>
          <dd class="wiki-meta-value">{fmtDate(updated)}</dd>
        </div>
        <div>
          <dt class="wiki-meta-key">출처</dt>
          <dd class="wiki-meta-value">{pad2(nSources)}</dd>
        </div>
        {
          aliases.length > 0 && (
            <div>
              <dt class="wiki-meta-key">별칭</dt>
              <dd class="wiki-meta-value">{aliases.join(', ')}</dd>
            </div>
          )
        }
      </dl>
    </header>

    {
      senses.length > 0 && (
        <section class="wiki-section" aria-labelledby="senses-title" data-reveal>
          <h2 id="senses-title">뜻 갈래</h2>
          <ol class="wiki-senses">
            {senses.map((sense) => (
              <li class="sense-item" data-read-unit>
                <span class="sense-context">{sense.context}</span>
                <p class="sense-def">
                  <Cited text={sense.definition} sourceCount={nSources} />
                </p>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      body.length > 0 && (
        <section class="wiki-section" aria-labelledby="body-title" data-reveal>
          <h2 id="body-title">본문</h2>
          <div class="wiki-body">
            {body.map((para) => (
              <p data-read-unit>
                <Cited text={para} sourceCount={nSources} />
              </p>
            ))}
          </div>
        </section>
      )
    }

    <section class="wiki-section wiki-sources" aria-labelledby="sources-title" data-read-unit data-reveal>
      <h2 id="sources-title">
        출처<span class="wiki-section-count">{pad2(nSources)}</span>
      </h2>
      <ol>
        {
          sourceRows.map((source, i) => (
            <li id={`src-${i + 1}`}>
              <a href={source.url} target="_blank" rel="noopener">
                {source.title}
              </a>
              <span class="wiki-source-origin">{source.origin}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <footer class="wiki-entry-foot" data-reveal>
      {
        relatedTerms.length > 0 && (
          <p class="wiki-related-line">
            <span class="wiki-related-label">관련 항목</span>
            {relatedTerms.map((item, index) => (
              <>
                {index > 0 && <span aria-hidden="true"> · </span>}
                <a href={wikiHref(item.data.slug)}>{item.data.term}</a>
              </>
            ))}
          </p>
        )
      }
      <div class="wiki-entry-actions">
        <button class="share-copy" type="button" data-copy-link aria-describedby="copy-status">
          링크 복사
        </button>
        <a class="wiki-entry-all" href={indexHref}>위키 전체 보기 →</a>
        <p class="copy-status" id="copy-status" role="status" aria-live="polite"></p>
      </div>
    </footer>

    <ReadingSheep total={readUnits} label="항목 읽기" />
  </article>

  <script>
    const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-link]');
    const copyStatus = document.querySelector<HTMLElement>('#copy-status');
    const canonicalLink = document.querySelector<HTMLLinkElement>('link[rel="canonical"]');
    const canonicalUrl = canonicalLink?.href ?? window.location.href;
    const IDLE_LABEL = '링크 복사';

    async function copyText(text: string): Promise<boolean> {
      if (navigator.clipboard) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch (error) {
          if (!(error instanceof Error)) throw error;
        }
      }

      const field = document.createElement('textarea');
      field.value = text;
      field.setAttribute('readonly', '');
      field.style.position = 'fixed';
      field.style.inset = '0 auto auto 0';
      field.style.opacity = '0';
      document.body.append(field);
      field.select();
      const copied = document.execCommand('copy');
      field.remove();
      return copied;
    }

    copyButton?.addEventListener('click', async () => {
      const copied = await copyText(canonicalUrl);
      copyButton.textContent = copied ? '복사함' : '복사 실패';
      if (copyStatus) copyStatus.textContent = copied ? '링크를 복사했습니다.' : '브라우저가 복사를 허용하지 않았습니다.';

      window.setTimeout(() => {
        copyButton.textContent = IDLE_LABEL;
        if (copyStatus) copyStatus.textContent = '';
      }, 2400);
    });
  </script>
</Base>
