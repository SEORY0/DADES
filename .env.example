# DADES public publication settings
#
# These values are read at build time and are safe to expose in generated pages.
# Leave a value blank to keep the corresponding link disabled.

# Optional external hosted newsletter subscribe page.
# Must be a valid HTTPS URL when set.
PUBLIC_NEWSLETTER_URL=

# Public contact address for partnership consultation.
# Must be a valid email address when set.
PUBLIC_CONTACT_EMAIL=dades.mag@gmail.com
