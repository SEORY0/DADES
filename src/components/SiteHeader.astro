---
import { href } from '../lib/mag';
import SheepMark from './SheepMark.astro';

interface NavigationItem {
  readonly key: string;
  readonly label: string;
  readonly to: string;
  readonly clipCount?: boolean;
}

interface Props {
  readonly active?: string;
  readonly nav: readonly NavigationItem[];
  readonly latestIssueTo: string;
  readonly latestIssueLabel: string;
}

const { active, nav, latestIssueTo, latestIssueLabel } = Astro.props;
---

<header class="site-head">
  <div class="nav-shell" data-glass-surface>
    <a class="brand" href={href('/')} aria-label="DADES 매거진 홈으로">
      <SheepMark class="brand-glyph" />
      <span class="brand-word" aria-hidden="true">DADES</span>
      <span class="sr-only">DADES</span>
    </a>
    <nav class="site-nav" aria-label="매거진 내비게이션">
      {
        nav.slice(0, 4).map((link) => (
          <a class="nav-link" href={link.to} aria-current={active === link.key ? 'page' : undefined}>
            <span class="nav-hover-pill" aria-hidden="true"></span>
            <span class="nav-active-pill" aria-hidden="true"></span>
            <span class="nav-label">{link.label}</span>
          </a>
        ))
      }
    </nav>
    <button
      class="menu-toggle"
      type="button"
      data-menu-toggle
      aria-label="메뉴 열기"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="menu-toggle-line" aria-hidden="true"></span>
      <span class="menu-toggle-line" aria-hidden="true"></span>
    </button>
    <a class="nav-cta" href={latestIssueTo}>
      <span>{latestIssueLabel}</span><span aria-hidden="true"> →</span>
    </a>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu data-glass-surface aria-hidden="true" inert>
    <nav aria-label="모바일 매거진 내비게이션">
      {
        nav.map((link, index) => (
          <a
            href={link.to}
            aria-current={active === link.key ? 'page' : undefined}
            data-menu-first={index === 0 ? '' : undefined}
          >
            <span>{link.label}</span>
            {link.clipCount && <span class="mobile-menu-meta" data-clip-count />}
          </a>
        ))
      }
    </nav>
    <div class="mobile-menu-socials">
      <a href={href('/rss.xml')}>RSS</a>
      <a href="https://github.com/seory0/DADES" target="_blank" rel="noopener">GitHub</a>
    </div>
  </div>
</header>
