---
import '../styles/global.css';
import SheepMark from '../components/SheepMark.astro';
import { href } from '../lib/mag';

interface Props {
  title: string;
  description?: string;
  /** 헤더에서 현재 위치 표시: home | archive | clippings | about */
  active?: string;
  /** OG 타입 — 이슈 지면은 article */
  ogType?: 'website' | 'article';
}

const {
  title,
  description = '사람이 고르고 클로드가 엮는 AI 주간지, DADES 매거진.',
  active,
  ogType = 'website',
} = Astro.props;

// 디렉터리형 URL로 통일 — sitemap 표기와 캐노니컬을 일치시킨다
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);
const ogImage = new URL(href('/og.png'), Astro.site);

const nav = [
  { key: 'home', label: '발행 목록', to: href('/') },
  { key: 'status', label: '상태판', to: href('/status/') },
  { key: 'archive', label: 'Index', to: href('/archive/') },
  { key: 'clippings', label: '스크랩북', to: href('/clippings/'), clipCount: true },
  { key: 'about', label: '소개', to: href('/about/') },
];
---

<!doctype html>
<html lang="ko" data-theme="paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — DADES 매거진</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="DADES 매거진" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="DADES 매거진"
      href={href('/rss.xml')}
    />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="manifest" href={href('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={href('/icons/apple-touch-icon.png')} />
    <meta name="theme-color" content="#f7f7f2" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@1,9..144,400..700,0..100,0..1&display=swap"
    />
    <script is:inline>
      // 테마 초기화 — 첫 페인트 전에 적용해 깜빡임을 막는다.
      // 저장된 선택이 없으면 시스템 다크모드를 따른다.
      (function () {
        try {
          var t = localStorage.getItem('dades:theme');
          if (t !== 'paper' && t !== 'white' && t !== 'ink') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'ink' : 'paper';
          }
          document.documentElement.setAttribute('data-theme', t);
          var bar = { paper: '#f7f7f2', white: '#ffffff', ink: '#1a1917' };
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', bar[t]);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>

    <header class="site-head">
      <div class="container">
        <a class="brand" href={href('/')} aria-label="DADES 매거진 홈으로">
          <SheepMark class="brand-sheep" />
          <span class="brand-name">DADES</span>
        </a>
        <nav class="site-nav" aria-label="매거진 내비게이션">
          {
            nav.map((link) => (
              <a href={link.to} aria-current={active === link.key ? 'page' : undefined}>
                {link.label}
                {link.clipCount && <span class="side-clip-count" data-clip-count />}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="page container" id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="container">
        <span class="foot-line">
          DADES — Do Agents Dream of Electric Sheep? ·
          <a href="https://github.com/seory0/DADES" target="_blank" rel="noopener">GitHub</a> ·
          <a href={href('/rss.xml')}>RSS</a>
        </span>
        <div class="theme-row" role="group" aria-label="지면 색 고르기">
          <button class="theme-swatch" data-set-theme="paper" aria-pressed="true" aria-label="종이색 테마" title="paper"></button>
          <button class="theme-swatch" data-set-theme="white" aria-pressed="false" aria-label="흰색 테마" title="white"></button>
          <button class="theme-swatch" data-set-theme="ink" aria-pressed="false" aria-label="먹색 테마" title="ink"></button>
        </div>
      </div>
    </footer>

    <script>
      // ---------- 테마 스위처 ----------
      const THEME_KEY = 'dades:theme';
      const swatches = document.querySelectorAll<HTMLButtonElement>('.theme-swatch');

      const THEME_BAR: Record<string, string> = { paper: '#f7f7f2', white: '#ffffff', ink: '#1a1917' };

      function applyTheme(theme: string) {
        document.documentElement.setAttribute('data-theme', theme);
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', THEME_BAR[theme]);
        swatches.forEach((b) =>
          b.setAttribute('aria-pressed', String(b.dataset.setTheme === theme)),
        );
        try {
          localStorage.setItem(THEME_KEY, theme);
        } catch {}
      }

      swatches.forEach((b) =>
        b.addEventListener('click', () => applyTheme(b.dataset.setTheme ?? 'paper')),
      );
      // 초기 상태를 버튼에 반영
      const current = document.documentElement.getAttribute('data-theme') ?? 'paper';
      swatches.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setTheme === current)));

      // ---------- 클리핑 ----------
      const CLIP_KEY = 'dades:clips:v1';

      function readClips(): Record<string, any> {
        try {
          const parsed = JSON.parse(localStorage.getItem(CLIP_KEY) ?? '{}');
          // 손상된 저장값(문자열·배열·숫자 등)으로부터 클립 버튼을 보호한다
          if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) return parsed;
        } catch {}
        return {};
      }

      function writeClips(clips: Record<string, any>) {
        try {
          localStorage.setItem(CLIP_KEY, JSON.stringify(clips));
        } catch {}
        updateClipCount();
      }

      function updateClipCount() {
        const n = Object.keys(readClips()).length;
        document.querySelectorAll<HTMLElement>('[data-clip-count]').forEach((el) => {
          el.textContent = n > 0 ? `(${n})` : '';
        });
      }

      // 클립 버튼·카운트를 저장소와 맞춘다 — 초기 로드, bfcache 복원, 다른 탭 변경 시
      function syncClipUi() {
        const clips = readClips();
        document.querySelectorAll<HTMLButtonElement>('.clip-btn[data-clip-id]').forEach((btn) => {
          const id = btn.dataset.clipId!;
          btn.setAttribute('aria-pressed', String(Boolean(clips[id])));
        });
        updateClipCount();
      }

      syncClipUi();
      window.addEventListener('pageshow', syncClipUi);
      window.addEventListener('storage', (e) => {
        if (e.key === CLIP_KEY || e.key === null) syncClipUi();
      });

      // ---------- 방문 기준선 ----------
      // "지난 방문 이후" 계산의 기준. 세션 안에서는 기준선을 고정해
      // 페이지를 오가도 홈의 방문 요약이 사라지지 않는다. (홈 스크립트와 같은 멱등 초기화)
      const SEEN_KEY = 'dades:last-seen';
      const BASELINE_KEY = 'dades:baseline';
      try {
        if (sessionStorage.getItem(BASELINE_KEY) === null) {
          sessionStorage.setItem(BASELINE_KEY, localStorage.getItem(SEEN_KEY) ?? '');
        }
        localStorage.setItem(SEEN_KEY, new Date().toISOString().slice(0, 10));
      } catch {}

      // ---------- 관심 태그 하이라이트 ----------
      const INTEREST_KEY = 'dades:interests:v1';

      function readInterests(): string[] {
        try {
          const parsed = JSON.parse(localStorage.getItem(INTEREST_KEY) ?? '[]');
          if (Array.isArray(parsed)) return parsed.filter((t) => typeof t === 'string');
        } catch {}
        return [];
      }

      const interests = new Set(readInterests());
      if (interests.size > 0) {
        document.querySelectorAll<HTMLElement>('.entry[data-tags]').forEach((entry) => {
          const tags = (entry.dataset.tags ?? '').split(',');
          if (tags.some((t) => interests.has(t))) entry.classList.add('is-interest');
        });
      }

      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.clip-btn[data-clip-id]');
        if (!btn) return;
        const id = btn.dataset.clipId!;
        const store = readClips();
        if (store[id]) {
          delete store[id];
          btn.setAttribute('aria-pressed', 'false');
        } else {
          let payload: any = null;
          try {
            payload = JSON.parse(btn.dataset.clipPayload ?? 'null');
          } catch {}
          if (!payload) return;
          store[id] = { ...payload, clippedAt: Date.now() };
          btn.setAttribute('aria-pressed', 'true');
        }
        writeClips(store);
      });
    </script>
  </body>
</html>
