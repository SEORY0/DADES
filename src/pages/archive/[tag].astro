---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import '../../styles/issue-archive.css';
import { collectTags, flattenItems, href, type FlatItem } from '../../lib/mag';

export async function getStaticPaths() {
  const issues = await getCollection('issues');
  const all = flattenItems(issues);
  return collectTags(issues).map(([tag]) => ({
    params: { tag },
    props: { matches: all.filter(({ item }) => item.tags.includes(tag)) },
  }));
}

interface Props {
  matches: FlatItem[];
}

const { matches } = Astro.props;
const { tag } = Astro.params;
---

<Base title={`#${tag} — 색인`} active="archive" layout="article">
  <article class="archive-tag-page">
    <header class="tag-head">
      <p class="ia-kicker">DADES INDEX</p>
      <h1>#{tag}</h1>
      <p class="tag-head-meta">이 주제로 실린 항목 <b>{matches.length}</b>건</p>
      <a class="ia-backlink" href={href('/archive/')}>← 전체 색인</a>
    </header>

    <section class="archive-results" aria-label={`#${tag} 수록 항목`}>
      {matches.map((flat) => <Entry flat={flat} showIssueRef headingLevel="h2" />)}
    </section>
  </article>
</Base>
