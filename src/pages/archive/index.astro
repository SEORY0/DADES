---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SOURCE_META, SOURCE_ORDER, collectTags, flattenItems, tagHref } from '../../lib/mag';

const issues = await getCollection('issues');
const tags = collectTags(issues);
const all = flattenItems(issues);

const totals = SOURCE_ORDER.map((key) => ({
  meta: SOURCE_META[key],
  count: all.filter(({ item }) => item.source === key).length,
})).filter((t) => t.count > 0);
---

<Base
  title="Index — 주제 색인"
  description="발행된 모든 큐레이션을 주제 태그로 다시 찾아보는 색인."
  active="archive"
>
  <header class="page-head">
    <h1 class="page-title">Index · 주제 색인</h1>
    <p class="page-desc">
      발행된 모든 항목을 태그로 다시 묶은 색인입니다. 그 글이 몇 호에 실렸는지 기억나지
      않을 때 여기서 찾으면 됩니다.
    </p>
  </header>

  <div class="index-search" data-index-search hidden></div>

  <p class="index-totals">
    지금까지 {totals.map((t) => `${t.meta.ko} ${t.count}`).join(' · ')} · 태그 {tags.length}
  </p>

  <p class="index-hint">
    ★로 관심 태그를 등록하면 지면에서 해당 항목이 표시되고, 홈의 방문 요약에 적중 여부가
    함께 나옵니다. 이 브라우저에만 저장됩니다.
  </p>

  <ul class="index-list">
    {
      tags.map(([tag, count]) => (
        <li class="index-row">
          <button
            class="interest-btn"
            data-interest-tag={tag}
            aria-pressed="false"
            aria-label={`관심 태그로 등록: ${tag}`}
          >★</button>
          <a class="index-line" href={tagHref(tag)}>
            <span class="index-tag">{tag}</span>
            <span class="leader" />
            <span class="count">{count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<script>
  // 관심 태그 토글 — localStorage에만 저장, 서버 전송 없음
  const INTEREST_KEY = 'dades:interests:v1';

  function read(): string[] {
    try {
      const parsed = JSON.parse(localStorage.getItem(INTEREST_KEY) ?? '[]');
      if (Array.isArray(parsed)) return parsed.filter((t) => typeof t === 'string');
    } catch {}
    return [];
  }

  function write(tags: string[]) {
    try {
      localStorage.setItem(INTEREST_KEY, JSON.stringify(tags));
    } catch {}
  }

  const buttons = document.querySelectorAll<HTMLButtonElement>('.interest-btn[data-interest-tag]');

  function sync() {
    const interests = new Set(read());
    buttons.forEach((btn) => {
      btn.setAttribute('aria-pressed', String(interests.has(btn.dataset.interestTag!)));
    });
  }

  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const tag = btn.dataset.interestTag!;
      const interests = new Set(read());
      interests.has(tag) ? interests.delete(tag) : interests.add(tag);
      write([...interests]);
      sync();
    }),
  );

  sync();
  window.addEventListener('pageshow', sync);
</script>

<script>
  // Pagefind 전문 검색 — 인덱스는 빌드 시 생성되므로(dev에는 없음) 있을 때만 붙인다.
  import { href } from '../../lib/mag';

  const mount = document.querySelector<HTMLElement>('[data-index-search]')!;
  const uiCss = href('/pagefind/pagefind-ui.css');
  const uiJs = href('/pagefind/pagefind-ui.js');

  fetch(uiJs, { method: 'HEAD' })
    .then((res) => {
      if (!res.ok) return;
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = uiCss;
      document.head.append(link);

      const script = document.createElement('script');
      script.src = uiJs;
      script.onload = () => {
        new (window as any).PagefindUI({
          element: mount,
          showSubResults: false,
          showImages: false,
          translations: {
            placeholder: '지면 전문 검색',
            clear_search: '지우기',
            load_more: '더 보기',
            zero_results: '“[SEARCH_TERM]” 결과 없음',
            many_results: '“[SEARCH_TERM]” 결과 [COUNT]건',
            one_result: '“[SEARCH_TERM]” 결과 1건',
            searching: '검색 중…',
          },
        });
        mount.hidden = false;
      };
      document.head.append(script);
    })
    .catch(() => {});
</script>
