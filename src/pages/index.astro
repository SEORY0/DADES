---
import { getCollection } from 'astro:content';
import IssueCard from '../components/IssueCard.astro';
import Base from '../layouts/Base.astro';
import { sortIssues } from '../lib/mag';
import '../styles/home-editorial.css';

const issues = sortIssues(await getCollection('issues'));
const topics = [
  { key: 'all', label: '전체' }, { key: 'ai', label: 'AI' },
  { key: 'agents', label: '에이전트' }, { key: 'security', label: 'AI 보안' },
];
---

<Base title="발행" description="AI와 AI 보안, 한 가지 주제를 짧고 깊게 읽는 DADES의 발행 모음." active="home" home>
  <section class="publication-gallery" aria-labelledby="gallery-title">
    <header class="gallery-header">
      <h1 id="gallery-title">발행 <span data-gallery-count aria-live="polite" aria-atomic="true" aria-label={`${issues.length}개 호`}>{issues.length}</span></h1>
      <div class="gallery-toolbar" data-gallery-toolbar hidden>
        <div class="gallery-filters" role="group" aria-label="발행 주제">
          {topics.map(({ key, label }) => (
            <button type="button" data-gallery-filter={key} aria-pressed={key === 'all'} aria-controls="issue-gallery">{label}</button>
          ))}
        </div>
        <label class="gallery-search">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4 4" /></svg>
          <span class="sr-only">발행 글 검색</span>
          <input type="search" data-gallery-query placeholder="관심 있는 글 찾기" maxlength="160" autocomplete="off" aria-controls="issue-gallery" />
        </label>
      </div>
    </header>
    <ul class="issue-gallery" id="issue-gallery">
      {issues.map((issue, index) => <IssueCard issue={issue} index={index} />)}
    </ul>
    <div class="gallery-empty" data-gallery-empty hidden>
      <p>아직 일치하는 글이 없어요.</p>
      <button type="button" data-gallery-reset>전체 발행 보기 <span aria-hidden="true">↗</span></button>
    </div>
  </section>
</Base>

<script>
  const toolbar = document.querySelector<HTMLElement>('[data-gallery-toolbar]');
  const query = document.querySelector<HTMLInputElement>('[data-gallery-query]');
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-gallery-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-issue-card]')];
  const count = document.querySelector<HTMLElement>('[data-gallery-count]');
  const empty = document.querySelector<HTMLElement>('[data-gallery-empty]');
  let topic = 'all';

  function render() {
    const terms = (query?.value ?? '').trim().toLocaleLowerCase('ko').split(/\s+/).filter(Boolean);
    const params = new URLSearchParams();
    if (topic !== 'all') params.set('topic', topic);
    if (query?.value.trim()) params.set('q', query.value.trim());
    const search = params.size ? `?${params}` : '';
    let visible = 0;
    cards.forEach((card) => {
      const matches = (topic === 'all' || card.dataset.topic === topic)
        && terms.every((term) => (card.dataset.search ?? '').includes(term));
      card.hidden = !matches;
      if (matches) visible += 1;
      const link = card.querySelector<HTMLAnchorElement>('[data-issue-link]');
      if (link) link.search = search;
    });
    filters.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.galleryFilter === topic)));
    if (count) { count.textContent = String(visible); count.setAttribute('aria-label', `${visible}개 호`); }
    if (empty) empty.hidden = visible > 0;
    history.replaceState(null, '', `${location.pathname}${search}${location.hash}`);
  }

  function restore() {
    const params = new URLSearchParams(location.search);
    const requested = params.get('topic');
    topic = filters.some((button) => button.dataset.galleryFilter === requested) ? (requested ?? 'all') : 'all';
    if (query) query.value = (params.get('q') ?? '').slice(0, 160);
    render();
  }
  filters.forEach((button) => button.addEventListener('click', () => {
    topic = button.dataset.galleryFilter ?? 'all';
    render();
  }));
  query?.addEventListener('input', render);
  document.querySelector('[data-gallery-reset]')?.addEventListener('click', () => {
    topic = 'all';
    if (query) query.value = '';
    render();
    filters[0]?.focus();
  });
  window.addEventListener('popstate', restore);
  window.addEventListener('pageshow', restore);
  cards.forEach((card) => {
    const image = card.querySelector('img');
    const hideBrokenImage = () => { image?.remove(); card.querySelector('a')?.classList.add('has-no-image'); };
    image?.addEventListener('error', hideBrokenImage);
    if (image?.complete && !image.naturalWidth) hideBrokenImage();
  });
  restore();
  if (toolbar) toolbar.hidden = false;
</script>
