---
// 전기양 글리프 — 양털 구름 + 번개 꼬리. currentColor로 그려져 어디서든 잉크색을 따른다.
//
// 세 벌을 갖는다. 같은 실루엣을 크기에 맞춰 다르게 새긴 것이지, 다른 그림이 아니다.
//  - detail  : 54px 이상. 양털 원 네 개가 겹쳐 구름을 이룬다(404·스크랩 지면).
//  - compact : 24~32px. 겹친 원은 이 크기에서 회색 낙서로 뭉개진다. 양털을
//              획이 겹치지 않는 윤곽선 하나로 줄이고 획을 굵혀(2 → 3) 실루엣만 남긴다.
//              22px에서 획이 0.88 장치픽셀까지 얇아지던 문제를 여기서 끊는다.
//  - mini    : 20px 이하(좁은 폭 여백에 서는 양 세기 표). 윤곽선은 이 크기에서
//              획 사이 흰 틈이 사라져 회색 얼룩이 된다 — 1배율 실측에서 compact는
//              양이 아니라 낙서로 보였다. 그래서 선을 버리고 **면**으로 새긴다.
//              양털은 원 네 개를 채워 톱니 윤곽(=털)을 남기고, 머리는 몸에서 떼어
//              실루엣이 "머리 달린 짐승"으로 읽히게 한다.
interface Props {
  class?: string;
  /** 글리프 밀도. 작은 자리(≈32px 이하)에는 compact, 20px 이하에는 mini. */
  variant?: 'detail' | 'compact' | 'mini';
}
const { class: className, variant = 'detail' } = Astro.props;
---

{
  variant === 'mini' ? (
    <svg
      class={className}
      viewBox="0 0 50 34"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <g fill="currentColor">
        <circle cx="16" cy="15" r="7.5" />
        <circle cx="24" cy="11.5" r="7.5" />
        <circle cx="31" cy="15" r="7" />
        <circle cx="22" cy="18" r="8" />
      </g>
      <path d="M16 23v8M27 23v8" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" />
      <rect x="37" y="9.5" width="11" height="10" rx="4.5" fill="currentColor" />
      <path d="M39 9.5l-2-4" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" />
      <path
        class="sheep-bolt"
        d="M8 12.5l-5 5h4.5l-5 5"
        stroke="currentColor"
        stroke-width="4"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  ) : variant === 'compact' ? (
    <svg
      class={className}
      viewBox="0 0 50 34"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M10 20C6 13.5 10.5 6 16.5 11.5C18.5 4 26.5 3 29 11C34 6.5 38.5 12.5 34 19C32 25.5 13 26 10 20Z"
        stroke="currentColor"
        stroke-width="3"
        stroke-linejoin="round"
      />
      <path d="M17 24v7M28 24v7" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
      <rect x="36" y="10.5" width="11" height="9" rx="4" fill="currentColor" />
      <path d="M37.5 10.5l-2-3.5" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
      <path
        class="sheep-bolt"
        d="M8 13l-5 4 4 1.2-5 4.4"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  ) : (
    <svg
      class={className}
      viewBox="0 0 50 34"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <g stroke="currentColor" stroke-width="2">
        <circle cx="17" cy="15" r="7" />
        <circle cx="25" cy="11" r="7" />
        <circle cx="32" cy="15" r="6.5" />
        <circle cx="23" cy="18" r="7.5" />
      </g>
      <rect x="37" y="10.5" width="9" height="7" rx="3.2" fill="currentColor" />
      <path
        d="M39 10.5l-1.6-3M44 10.5l1.6-3"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      />
      <path d="M19 26v6M29 26v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      <path
        class="sheep-bolt"
        d="M10 13l-5.5 3.8 4 1.4-5.5 4.6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}
