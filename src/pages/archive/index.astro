---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/issue-archive.css';
import '../../styles/reference-index.css';
import { SOURCE_META, SOURCE_ORDER, collectTags, flattenItems, tagHref } from '../../lib/mag';

const issues = await getCollection('issues');
const tags = collectTags(issues);
const all = flattenItems(issues);

const totals = SOURCE_ORDER.map((key) => ({
  key,
  meta: SOURCE_META[key],
  count: all.filter(({ item }) => item.source === key).length,
})).filter((t) => t.count > 0);
---

<Base
  title="Index — 주제 색인"
  description="발행된 모든 큐레이션을 주제 태그로 다시 찾아보는 색인."
  active="archive"
  layout="listing"
>
  <div class="reference-index topic-index">
  <section class="index-head" aria-labelledby="archive-title">
    <div class="index-headline">
      <h1 id="archive-title">주제 색인</h1>
      <p class="index-lede">
        주제별로 소식을 모아 보고, 관심 있는 태그를 저장하세요.
      </p>
    </div>

    <div class="index-find">
      <div class="index-search" data-index-search hidden></div>
      <p class="index-search-fallback">
        전문 검색은 빌드된 지면에서만 켜집니다. 지금은 아래 태그 색인으로 찾아 주세요.
      </p>
    </div>

    <div class="index-stats">
      <dl aria-label="색인 총계">
        <div><dt>항목</dt><dd>{all.length}</dd></div>
        <div><dt>태그</dt><dd>{tags.length}</dd></div>
        <div><dt>발행 호</dt><dd>{issues.length}</dd></div>
      </dl>
      <dl aria-label="출처별 항목 수">
        {
          totals.map((total) => (
            <div>
              <dt>{total.meta.ko}</dt>
              <dd>{total.count}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="index-tags" aria-labelledby="tag-index-title">
    <div class="index-tags-head">
      <h2 id="tag-index-title">전체 태그</h2>
      <p class="index-hint">
        별표를 눌러 관심 태그를 저장하세요. 이 브라우저에만 저장됩니다.
      </p>
    </div>

    <ul class="index-list">
      {
        tags.map(([tag, count]) => (
          <li class="index-row">
            <button
              class="interest-btn"
              data-interest-tag={tag}
              aria-pressed="false"
              aria-label={`관심 태그로 등록: ${tag}`}
            ><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9-5.6 2.9 1.1-6.2L3 9.6l6.2-.9Z" /></svg></button>
            <a class="index-line" href={tagHref(tag)}>
              <span class="index-tag">{tag}</span>
              <span class="leader" />
              <span class="count">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  </div>
</Base>

<script>
  // 관심 태그 토글 — localStorage에만 저장, 서버 전송 없음
  const INTEREST_KEY = 'dades:interests:v1';

  function read(): string[] {
    try {
      const parsed = JSON.parse(localStorage.getItem(INTEREST_KEY) ?? '[]');
      if (Array.isArray(parsed)) return parsed.filter((t) => typeof t === 'string');
    } catch {}
    return [];
  }

  function write(tags: string[]) {
    try {
      localStorage.setItem(INTEREST_KEY, JSON.stringify(tags));
    } catch {}
  }

  const buttons = document.querySelectorAll<HTMLButtonElement>('.interest-btn[data-interest-tag]');

  function sync() {
    const interests = new Set(read());
    buttons.forEach((btn) => {
      const tag = btn.dataset.interestTag;
      if (!tag) return;
      btn.setAttribute('aria-pressed', String(interests.has(tag)));
    });
  }

  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const tag = btn.dataset.interestTag;
      if (!tag) return;
      const interests = new Set(read());
      interests.has(tag) ? interests.delete(tag) : interests.add(tag);
      write([...interests]);
      sync();
    }),
  );

  sync();
  window.addEventListener('pageshow', sync);
</script>

<script>
  // Pagefind 전문 검색 — 인덱스는 빌드 시 생성되므로(dev에는 없음) 있을 때만 붙인다.
  import { href } from '../../lib/mag';

  interface PagefindOptions {
    element: HTMLElement;
    showSubResults: boolean;
    showImages: boolean;
    translations: Record<string, string>;
  }

  type PagefindConstructor = new (options: PagefindOptions) => unknown;
  const pagefindWindow = window as Window & { PagefindUI?: PagefindConstructor };
  const mount = document.querySelector<HTMLElement>('[data-index-search]');
  const uiCss = href('/pagefind/pagefind-ui.css');
  const uiJs = href('/pagefind/pagefind-ui.js');
  // 검색칸 이름표 — 자리글과 같은 문구를 쓴다
  const SEARCH_LABEL = '지면 전문 검색';

  /** Pagefind가 심는 입력칸은 title=과 자리글뿐이라 낭독기에 이름이 없다.
   *  마크업이 Pagefind 쪽 것이라 붙은 뒤에 같은 문구를 aria-label로 달아 준다.
   *  속성 변화는 지켜보지 않으므로 되돌이는 생기지 않는다. */
  function labelSearchInput(root: HTMLElement) {
    const tag = () => {
      const input = root.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
      if (input) input.setAttribute('aria-label', SEARCH_LABEL);
    };
    tag();
    new MutationObserver(tag).observe(root, { childList: true, subtree: true });
  }

  if (mount) fetch(uiJs, { method: 'HEAD' })
    .then((res) => {
      if (!res.ok) return;
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = uiCss;
      document.head.append(link);

      const script = document.createElement('script');
      script.src = uiJs;
      script.onload = () => {
        const PagefindUI = pagefindWindow.PagefindUI;
        if (!PagefindUI) return;
        new PagefindUI({
          element: mount,
          showSubResults: false,
          showImages: false,
          translations: {
            placeholder: SEARCH_LABEL,
            clear_search: '지우기',
            load_more: '더 보기',
            zero_results: '“[SEARCH_TERM]” 결과 없음',
            many_results: '“[SEARCH_TERM]” 결과 [COUNT]건',
            one_result: '“[SEARCH_TERM]” 결과 1건',
            searching: '검색 중…',
          },
        });
        labelSearchInput(mount);
        mount.hidden = false;
      };
      document.head.append(script);
    })
    .catch(() => {});
</script>
