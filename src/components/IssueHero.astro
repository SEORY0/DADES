---
import { SIGNAL_META, fmtDate, issueNo, type Item } from '../lib/mag';

/**
 * 호 머리 — 무슨 호인지, 언제 모았는지, 몇 건인지, 무엇이 행동을 요구하는지.
 * 읽기 시작하기 전에 필요한 것만 한 덩어리로 짧게 둔다. 어두운 벌판도,
 * 첫 문장까지 1,200px을 미루던 패턴 그림도 없다.
 */
interface Props {
  number: number;
  title: string;
  date: string;
  period?: string;
  intro?: string;
  items: Item[];
  signals: {
    action: number;
    context: number;
    noise: number;
  };
  firstActionId?: string;
}

const { number, title, date, period, intro, items, signals, firstActionId } = Astro.props;
---

<header class="issue-head">
  <p class="ia-kicker">DADES WEEKLY · ISSUE {issueNo(number)}</p>
  <h1 class="issue-title">{title}</h1>
  {intro && <p class="issue-deck">{intro}</p>}

  <dl class="issue-facts" aria-label="이번 호 정보">
    <div>
      <dt>발행</dt>
      <dd>{fmtDate(date)}</dd>
    </div>
    {
      period && (
        <div>
          <dt>수집 기간</dt>
          <dd>{period}</dd>
        </div>
      )
    }
    <div>
      <dt>항목</dt>
      <dd>{items.length}건</dd>
    </div>
  </dl>

  <div class="signal-row issue-head-signals" role="group" aria-label="이번 호 신호">
    <div class="signal-bar" aria-hidden="true">
      {signals.action > 0 && <span class="seg-action" style={`flex-grow:${signals.action}`} />}
      {signals.context > 0 && <span class="seg-context" style={`flex-grow:${signals.context}`} />}
      {signals.noise > 0 && <span class="seg-noise" style={`flex-grow:${signals.noise}`} />}
    </div>
    <p class="signal-legend">
      {
        firstActionId ? (
          <a href={`#${firstActionId}`}>
            <span class="key key-action" aria-hidden="true" /> {SIGNAL_META.action.ko}{' '}
            {signals.action}
          </a>
        ) : (
          <span>
            <span class="key key-action" aria-hidden="true" /> {SIGNAL_META.action.ko} 0
          </span>
        )
      }
      <span>
        <span class="key key-context" aria-hidden="true" /> {SIGNAL_META.context.ko}{' '}
        {signals.context}
      </span>
      <span>
        <span class="key key-noise" aria-hidden="true" /> {SIGNAL_META.noise.ko} {signals.noise}
      </span>
    </p>
  </div>
</header>
