---
import Base from '../layouts/Base.astro';
import SheepMark from '../components/SheepMark.astro';
import { href } from '../lib/mag';
---

<Base
  title="내 스크랩북"
  description="지면을 읽다 오려둔 조각들을 모아두는 곳."
  active="clippings"
>
  <header class="page-head">
    <p class="page-kicker">Clippings</p>
    <h1 class="page-title">내 스크랩북</h1>
    <p class="page-desc">
      각 항목의 클립 버튼을 누르면 여기 모입니다. 저장 위치는 이 브라우저의 localStorage뿐이고,
      서버로는 아무것도 보내지 않습니다. 필요하면 Markdown으로 복사해 가세요.
    </p>
  </header>

  <div class="scrap-toolbar" data-scrap-toolbar hidden>
    <span class="scrap-count" data-scrap-count></span>
    <button class="scrap-action" data-scrap-copy>Markdown으로 복사</button>
    <button class="scrap-action danger" data-scrap-clear>모두 비우기</button>
  </div>

  <p class="sr-only" role="status" data-scrap-status></p>

  <div data-scrap-list></div>

  <div class="scrap-empty" data-scrap-empty hidden tabindex="-1">
    <SheepMark class="sheep" />
    <p>아직 오려둔 조각이 없습니다.</p>
    <p class="hint">지면의 <code>✂ 클립</code> 버튼을 누르면 이곳으로 모입니다.</p>
    <p class="hint"><a href={href('/')}>최신호 읽으러 가기 →</a></p>
  </div>

  <noscript>
    <div class="scrap-empty">
      <p><strong>스크랩북은 JavaScript가 필요합니다.</strong></p>
      <p class="hint">클립은 이 브라우저의 localStorage에 저장되고, 여기서만 다시 펼쳐집니다.</p>
    </div>
  </noscript>
</Base>

<script>
  import { SOURCE_META, issueHref } from '../lib/mag';

  const CLIP_KEY = 'dades:clips:v1';

  interface Clip {
    id: string;
    title: string;
    url: string;
    source: string;
    origin: string | null;
    tags: string[];
    summary: string;
    note: string | null;
    issue: { number: number; title: string; date: string };
    clippedAt: number;
  }

  const listEl = document.querySelector<HTMLElement>('[data-scrap-list]')!;
  const emptyEl = document.querySelector<HTMLElement>('[data-scrap-empty]')!;
  const toolbarEl = document.querySelector<HTMLElement>('[data-scrap-toolbar]')!;
  const countEl = document.querySelector<HTMLElement>('[data-scrap-count]')!;
  const statusEl = document.querySelector<HTMLElement>('[data-scrap-status]')!;
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-scrap-copy]')!;
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-scrap-clear]')!;

  const isRecord = (v: unknown): v is Record<string, unknown> =>
    typeof v === 'object' && v !== null && !Array.isArray(v);

  /** 저장된 값이 스크랩북이 그릴 수 있는 모양인지 — 손상된 조각은 조용히 건너뛴다 */
  function isRenderableClip(v: unknown): v is Clip {
    if (!isRecord(v)) return false;
    const issue = v.issue;
    return (
      typeof v.id === 'string' &&
      typeof v.title === 'string' &&
      typeof v.url === 'string' &&
      typeof v.summary === 'string' &&
      isRecord(issue) &&
      typeof issue.number === 'number' &&
      typeof issue.date === 'string'
    );
  }

  function readClips(): Record<string, unknown> {
    try {
      const parsed = JSON.parse(localStorage.getItem(CLIP_KEY) ?? '{}');
      if (isRecord(parsed)) return parsed;
    } catch {}
    return {};
  }

  function writeClips(clips: Record<string, unknown>) {
    try {
      localStorage.setItem(CLIP_KEY, JSON.stringify(clips));
    } catch {}
    document.querySelectorAll<HTMLElement>('[data-clip-count]').forEach((el) => {
      const n = Object.keys(clips).length;
      el.textContent = n > 0 ? `(${n})` : '';
    });
  }

  const sorted = (): Clip[] =>
    Object.values(readClips())
      .filter(isRenderableClip)
      .sort((a, b) => (b.clippedAt ?? 0) - (a.clippedAt ?? 0));

  function el<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className?: string,
    text?: string,
  ): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  const pad = (n: number) => String(n).padStart(2, '0');
  const fmtDate = (iso: string) => iso.replaceAll('-', '.');

  function announce(message: string) {
    statusEl.textContent = message;
  }

  function renderEntry(clip: Clip, index: number): HTMLElement {
    const entry = el('article', 'entry');

    const top = el('div', 'entry-top');
    const headline = el('div', 'entry-headline');
    const title = el('h2', 'entry-title');
    const link = el('a', undefined, clip.title);
    link.href = clip.url;
    link.target = '_blank';
    link.rel = 'noopener';
    title.append(link);
    headline.append(title);
    const metaText = [SOURCE_META[clip.source]?.ko ?? clip.source, clip.origin]
      .filter(Boolean)
      .join(' · ');
    headline.append(el('span', 'entry-meta', metaText));
    top.append(headline);

    const remove = el('button', 'clip-btn', '빼기');
    remove.setAttribute('aria-label', `스크랩북에서 빼기: ${clip.title}`);
    remove.addEventListener('click', () => {
      const clips = readClips();
      delete clips[clip.id];
      writeClips(clips);
      render();
      announce(`스크랩북에서 뺐습니다 — 남은 조각 ${Object.keys(clips).length}`);
      // 포커스를 다음 항목의 빼기 버튼으로 (마지막이었으면 이전 항목, 다 비었으면 빈 상태로)
      const removeBtns = listEl.querySelectorAll<HTMLButtonElement>('.clip-btn');
      if (removeBtns.length > 0) {
        removeBtns[Math.min(index, removeBtns.length - 1)].focus();
      } else {
        emptyEl.focus();
      }
    });
    top.append(remove);
    entry.append(top);

    entry.append(el('p', 'entry-summary', clip.summary));
    if (typeof clip.note === 'string' && clip.note) entry.append(el('p', 'entry-note', clip.note));

    if (Array.isArray(clip.tags) && clip.tags.length) {
      const tags = el('p', 'entry-tags');
      for (const tag of clip.tags) tags.append(el('span', 'tag-link', `#${String(tag)}`));
      entry.append(tags);
    }

    const ref = el('p', 'entry-issue-ref');
    ref.append(
      document.createTextNode(
        `Issue № ${pad(clip.issue.number)} · ${fmtDate(clip.issue.date)} · `,
      ),
    );
    const refLink = el('a', undefined, '지면에서 보기');
    refLink.href = `${issueHref(clip.issue.number)}#${clip.id}`;
    refLink.append(el('span', 'sr-only', `: ${clip.title}`));
    ref.append(refLink);
    entry.append(ref);

    return entry;
  }

  function render() {
    const clips = sorted();
    listEl.replaceChildren(...clips.map(renderEntry));
    emptyEl.hidden = clips.length > 0;
    toolbarEl.hidden = clips.length === 0;
    countEl.textContent = `오려둔 조각 ${clips.length}`;
  }

  function toMarkdown(): string {
    const lines = ['# DADES 스크랩북', ''];
    for (const clip of sorted()) {
      lines.push(`## [${clip.title}](${clip.url})`);
      const meta = [
        SOURCE_META[clip.source]?.ko ?? clip.source,
        clip.origin,
        `Issue №${pad(clip.issue.number)} (${clip.issue.date})`,
      ].filter(Boolean);
      lines.push(`- ${meta.join(' · ')}`);
      if (Array.isArray(clip.tags) && clip.tags.length)
        lines.push(`- 태그: ${clip.tags.map((t) => `#${t}`).join(' ')}`);
      lines.push('', `> ${clip.summary}`, '');
      if (clip.note) lines.push(`> ✎ ${clip.note}`, '');
    }
    return lines.join('\n');
  }

  const COPY_LABEL = copyBtn.textContent;
  let copyTimer: ReturnType<typeof setTimeout> | undefined;

  function flashCopyLabel(label: string, message: string) {
    copyBtn.textContent = label;
    announce(message);
    clearTimeout(copyTimer);
    copyTimer = setTimeout(() => (copyBtn.textContent = COPY_LABEL), 1600);
  }

  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(toMarkdown());
      flashCopyLabel('복사됨 ✓', '스크랩북을 Markdown으로 복사했습니다');
    } catch {
      flashCopyLabel('복사 실패', '복사에 실패했습니다 — 브라우저 클립보드 권한을 확인하세요');
    }
  });

  clearBtn.addEventListener('click', () => {
    if (!confirm('스크랩북을 모두 비울까요? 되돌릴 수 없습니다.')) return;
    writeClips({});
    render();
    announce('스크랩북을 비웠습니다');
    emptyEl.focus();
  });

  render();
  window.addEventListener('pageshow', render);
  window.addEventListener('storage', (e) => {
    if (e.key === CLIP_KEY || e.key === null) render();
  });
</script>
