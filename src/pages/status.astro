---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import '../styles/immersive-pages.css';
import { STATUS_META, flattenChangelog, fmtDate, issueHref, issueNo, sortBoards } from '../lib/mag';

const boards = sortBoards(await getCollection('boards'));
const rows = boards.flatMap((b) => b.data.rows);
const updated = boards.map((b) => b.data.updated).sort().at(-1) ?? '';
const count = (s: string) => rows.filter((r) => r.status === s).length;
const changelog = flattenChangelog(boards);

/** 세로로 비교되는 수는 전부 두 자리로 맞춘다 — tabular-nums와 짝. */
const pad2 = (n: number) => String(n).padStart(2, '0');

/** 머리의 집계가 그대로 표의 색 범례를 겸한다. 그래서 별도 legend를 두지 않는다. */
const tally = [
  { label: '기준일', value: fmtDate(updated), status: null, zero: false },
  { label: '항목', value: pad2(rows.length), status: null, zero: rows.length === 0 },
  { label: '안정', value: pad2(count('stable')), status: 'stable', zero: count('stable') === 0 },
  { label: '주시', value: pad2(count('watch')), status: 'watch', zero: count('watch') === 0 },
  { label: '변경', value: pad2(count('changed')), status: 'changed', zero: count('changed') === 0 },
];
---

<Base
  title="상태판"
  description="뉴스가 아니라 현재 상태. 지금 뭘 쓰면 되는지에 대한 에디터의 답과 변경 이력."
  active="status"
  layout="immersive"
>
  <!-- 1. 상태판 머리 — 표를 읽기 전에 '바뀐 게 있나'부터 답한다. -->
  <section
    class="status-section status-masthead"
    data-status-scene
    data-immersive-hero
    aria-labelledby="status-masthead-title"
  >
    <div class="status-shell">
      <div class="status-masthead-copy">
        <p class="immersive-label">STATUS BOARD</p>
        <h1 id="status-masthead-title">뉴스가 아니라, 지금의 답</h1>
        <p class="status-deck">
          뉴스는 흘러가고 여기엔 현재 답만 남습니다. 이 판이 지난번과 같다면
          그 주의 소식은 몰라도 됩니다.
        </p>
      </div>
      <dl class="status-tally" aria-label="상태 집계">
        {
          tally.map((item) => (
            <div class="status-tally-item" data-zero={item.zero ? 'true' : undefined}>
              <dt data-status={item.status}>
                {item.status && <span class="status-dot" aria-hidden="true" />}
                {item.label}
              </dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 2. 보드 — 두 판이 같은 컬럼 트랙을 써서 세로로 비교된다. -->
  <section class="status-section status-boards" aria-labelledby="status-boards-title">
    <div class="status-shell">
      <h2 id="status-boards-title" class="sr-only">현재 상태 보드</h2>
      <div class="status-table" role="table" aria-labelledby="status-boards-title" aria-colcount="4">
        <div role="rowgroup">
          <div class="status-row status-row-head" role="row">
            <span role="columnheader">영역</span>
            <span role="columnheader">현재 답</span>
            <span role="columnheader">상태</span>
            <span role="columnheader">기준일</span>
          </div>
        </div>
        {
          boards.map((board) => (
            <div class="status-group" role="rowgroup">
              <div class="status-group-head" role="row">
                <div class="status-group-cell" role="cell" aria-colspan="3">
                  <h3 class="status-group-title" id={`${board.data.slug}-title`}>{board.data.title}</h3>
                  <p class="status-group-question">{board.data.question}</p>
                </div>
                {/* 점검일은 아래 기준일 열과 같은 트랙(4열)에 세운다 — 같은 날짜가 두 자리에 찍히면 안 된다. */}
                <time class="status-group-updated" role="cell" datetime={board.data.updated}>
                  점검 {fmtDate(board.data.updated)}
                </time>
              </div>
              {board.data.rows.map((row) => (
                <div class="status-row" role="row" id={`${board.data.slug}-${row.id}`}>
                  <span class="status-area" role="cell">{row.area}</span>
                  <span class="status-pick" role="cell">
                    {row.url ? (
                      <a href={row.url} target="_blank" rel="noopener">
                        {row.pick}
                        <span class="status-ext" aria-hidden="true">↗</span>
                      </a>
                    ) : (
                      <strong>{row.pick}</strong>
                    )}
                    {row.note && <span class="status-note">{row.note}</span>}
                  </span>
                  <span class="status-state" role="cell" data-status={row.status}>
                    <span class="status-dot" aria-hidden="true" />
                    {STATUS_META[row.status].ko}
                  </span>
                  <span class="status-since" role="cell">
                    <time datetime={row.since}>{fmtDate(row.since)}</time>
                  </span>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. 변경 이력 — '지난번 이후 뭐가 바뀌었나'의 근거.
       열은 위 상태표와 같은 트랙을 쓴다: 영역 · 내용 · 출처 · 날짜. -->
  <section class="status-section status-changelog" aria-labelledby="status-changelog-title">
    <div class="status-shell">
      <div class="status-changelog-head">
        <h2 id="status-changelog-title">변경 이력</h2>
        <span class="status-changelog-count">{pad2(changelog.length)}건</span>
      </div>
      {
        changelog.length === 0 ? (
          <p class="status-empty">아직 기록된 변경이 없습니다.</p>
        ) : (
          <ol class="status-changelog-list">
            {changelog.map((entry) => (
              <li class="status-changelog-item">
                <span class="status-changelog-board">{entry.board}</span>
                <p class="status-changelog-text">{entry.text}</p>
                {entry.issue != null && (
                  <a class="status-changelog-ref" href={issueHref(entry.issue)}>
                    {issueNo(entry.issue)}
                  </a>
                )}
                <time datetime={entry.date}>{fmtDate(entry.date)}</time>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>
</Base>
