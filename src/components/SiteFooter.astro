---
import { href } from '../lib/mag';

interface Props {
  readonly latestIssueTo: string;
  readonly latestIssueLabel: string;
}

const { latestIssueTo, latestIssueLabel } = Astro.props;
const year = new Date().getFullYear();
---

{/*
  푸터 — 어두운 띠는 정체성이라 남기고, 매 지면 끝을 가로막던 파란 CTA 판은 걷어냈다.
  제호(로고 마크) · 한 줄 소개 · 최신 호로 가는 링크 하나 · 지면 목록 · 판권.
  최신 호 링크는 여기 한 번만 나오고, 나머지는 전부 조용한 헤어라인 위에 앉는다.
*/}
<footer class="site-foot">
  <div class="foot-inner">
    <div class="foot-top">
      <div class="foot-brand">
        <img
          class="foot-mark"
          src={href('/brand/dades-editorial-logo.webp')}
          width="1128"
          height="912"
          alt="DADES"
          loading="lazy"
          decoding="async"
        />
        <p class="foot-tagline">AI의 흐름과 보안의 기준.<br />새로운 기술을 읽고, 다음 판단의 근거를 모읍니다.</p>
      </div>

      <a class="foot-latest" href={latestIssueTo}>
        <span>{latestIssueLabel}</span><span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="foot-grid">
      <nav class="foot-links" aria-label="푸터 내비게이션">
        <a href={href('/')}>발행</a>
        <a href={href('/status/')}>상태판</a>
        <a href={href('/wiki/')}>위키</a>
        <a href={href('/archive/')}>Index</a>
        <a href={href('/about/')}>소개</a>
        <a href={href('/clippings/')}>스크랩북 <span data-clip-count /></a>
        <a href={href('/rss.xml')}>RSS</a>
        <a href={href('/subscribe/')}>구독</a>
        <a href={href('/partner/')}>광고·제휴</a>
        <a href="https://github.com/seory0/DADES" target="_blank" rel="noopener">GitHub</a>
      </nav>

      <div class="foot-meta">
        <div class="theme-row" role="group" aria-label="지면 색 고르기">
          <button class="theme-swatch" data-set-theme="paper" aria-pressed="true" aria-label="Paper 종이색 테마" title="paper"><span>Paper</span></button>
          <button class="theme-swatch" data-set-theme="white" aria-pressed="false" aria-label="White 흰색 테마" title="white"><span>White</span></button>
          <button class="theme-swatch" data-set-theme="ink" aria-pressed="false" aria-label="Ink 먹색 테마" title="ink"><span>Ink</span></button>
        </div>
        <p>© {year} DADES. Independent AI & AI Security Magazine.</p>
        <p>
          Patterns generated with <a href="https://bookofshapes.com/" target="_blank" rel="noopener">Book of Shapes</a>
          by Nikolaj Sokolowski.
        </p>
      </div>
    </div>
  </div>
</footer>
