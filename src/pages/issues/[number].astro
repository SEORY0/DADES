---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import IssueHero from '../../components/IssueHero.astro';
import '../../styles/issue-archive.css';
import {
  SOURCE_META,
  SOURCE_ORDER,
  issueHref,
  issueNo,
  signalCounts,
  sortIssues,
  type Issue,
} from '../../lib/mag';

export async function getStaticPaths() {
  const issues = sortIssues(await getCollection('issues'));
  return issues.map((issue, i) => ({
    params: { number: String(issue.data.number) },
    props: {
      issue,
      newer: issues[i - 1] ?? null,
      older: issues[i + 1] ?? null,
    },
  }));
}

interface Props {
  issue: Issue;
  newer: Issue | null;
  older: Issue | null;
}

const { issue, newer, older } = Astro.props;
const { number, title, date, period, intro, items } = issue.data;

const sections = SOURCE_ORDER.map((key) => ({
  key,
  meta: SOURCE_META[key],
  items: items.filter((it) => it.source === key),
})).filter((s) => s.items.length > 0);

// 단독 섹션 위주의 호는 헤딩이 본문보다 무거워진다 —
// 섹션 수가 아이템 수의 절반을 넘으면 섹션 없이 수록 순서대로 편성한다.
const useSections = sections.length <= items.length / 2;

const signals = signalCounts(items);
const firstAction = items.find((it) => it.signal === 'action');

const flat = (item: (typeof items)[number]) => ({
  item,
  issue: { number, title, date },
});
---

<Base title={`Issue ${issueNo(number)} — ${title}`} description={intro} active="home" ogType="article" layout="article">
  <article class="issue-article">
    <IssueHero
      number={number}
      title={title}
      date={date}
      period={period}
      intro={intro}
      items={items}
      signals={signals}
      firstActionId={firstAction?.id}
    />

    <div class="issue-reading" data-pagefind-body>
      {
        useSections ? (
          sections.map((section) => (
            <section class="issue-section" aria-label={section.meta.ko} data-reveal>
              <h2 class="section-heading">
                {section.meta.ko}
                <span class="count">{section.items.length}</span>
              </h2>
              {section.items.map((item) => (
                <Entry flat={flat(item)} />
              ))}
            </section>
          ))
        ) : (
          <section aria-label="이번 호 수록" class="flat-entries issue-section" data-reveal>
            {items.map((item) => (
              <Entry flat={flat(item)} headingLevel="h2" />
            ))}
          </section>
        )
      }
    </div>

    <nav class="issue-pager" aria-label="이슈 넘기기" data-reveal>
      <span>
        {older && (
          <a href={issueHref(older.data.number)}>← 지난 호 {issueNo(older.data.number)}</a>
        )}
      </span>
      <span>
        {newer && (
          <a href={issueHref(newer.data.number)}>다음 호 {issueNo(newer.data.number)} →</a>
        )}
      </span>
    </nav>
  </article>
</Base>
