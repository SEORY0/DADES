---
import { href } from '../lib/mag';
import { publicationConfig } from '../lib/publication';

const rssUrl = new URL(href('/rss.xml'), Astro.site).toString();
const newsletterUrl = publicationConfig.newsletterUrl;
---

<aside class="newsletter-card" aria-labelledby="newsletter-card-title">
  <div class="newsletter-copy">
    <p class="publication-label">SUBSCRIBE</p>
    <h2 id="newsletter-card-title">다음 호도, 당신의 리더에서.</h2>
    {
      newsletterUrl ? (
        <p>
          뉴스레터 구독 페이지가 연결되어 있습니다. 메일로 새 호를 받고 싶다면
          아래 링크에서 구독을 이어가세요.
        </p>
      ) : (
        <p>
          RSS 리더에 DADES를 추가하세요. 새 호가 발행되면 한곳에서 읽을 수 있습니다.
          이메일 뉴스레터는 준비 중입니다.
        </p>
      )
    }
  </div>

  <div class="newsletter-actions">
    {
      newsletterUrl ? (
        <a class="publication-button" href={newsletterUrl} target="_blank" rel="noopener">
          뉴스레터 구독 페이지 열기
        </a>
      ) : (
        <>
          <a class="publication-button" href={href('/rss.xml')}>RSS 열기</a>
          <a class="publication-button publication-button-secondary" href={href('/subscribe/')}>
            구독 안내
          </a>
        </>
      )
    }

    <div class="rss-copy">
      <code data-rss-url>{rssUrl}</code>
      <button type="button" class="rss-copy-button" data-copy-rss={rssUrl}>
        RSS URL 복사
      </button>
      <p class="rss-copy-status" data-copy-status aria-live="polite"></p>
    </div>
  </div>
</aside>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-rss]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');

  button?.addEventListener('click', async () => {
    const value = button.dataset.copyRss;
    if (!value || !navigator.clipboard) {
      if (status) status.textContent = '복사 기능을 쓸 수 없습니다. 주소를 직접 선택해 주세요.';
      return;
    }

    try {
      await navigator.clipboard.writeText(value);
      if (status) status.textContent = 'RSS 주소를 복사했습니다.';
    } catch {
      if (status) status.textContent = '복사하지 못했습니다. 주소를 직접 선택해 주세요.';
    }
  });
</script>

<style>
  .newsletter-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 27rem);
    gap: var(--space-8);
    padding: var(--space-6);
    border-top: 2px solid var(--text-primary);
    border-bottom: 1px solid var(--rule-default);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--accent-wash) 76%, transparent), transparent 58%),
      var(--surface-raised);
  }

  .publication-label {
    margin: 0;
    font-size: var(--front-label, var(--type-label));
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: var(--front-track, 0.12em);
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .newsletter-copy h2 {
    margin: var(--space-3) 0 0;
    font-size: clamp(1.375rem, 2vw, 2rem);
    font-weight: 640;
    line-height: 1.18;
    letter-spacing: -0.02em;
  }

  .newsletter-copy p:not(.publication-label) {
    max-width: 48ch;
    margin: var(--space-4) 0 0;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .newsletter-actions {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .publication-button,
  .rss-copy-button {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-inline: var(--space-4);
    border: 1px solid var(--accent-primary);
    color: var(--accent-primary);
    font-size: 0.9375rem;
    font-weight: 620;
    line-height: 1;
    text-decoration: none;
  }

  .publication-button:hover,
  .publication-button:focus-visible,
  .rss-copy-button:hover,
  .rss-copy-button:focus-visible {
    color: var(--surface-canvas);
    background: var(--accent-primary);
  }

  .publication-button-secondary {
    border-color: var(--rule-default);
    color: var(--text-primary);
  }

  .publication-button-secondary:hover,
  .publication-button-secondary:focus-visible {
    border-color: var(--accent-primary);
  }

  .rss-copy {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .rss-copy code {
    min-width: 0;
    padding: var(--space-3);
    overflow-wrap: anywhere;
    border: 1px solid var(--rule-soft);
    background: var(--surface-canvas);
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: var(--type-small);
  }

  .rss-copy-status {
    min-height: 1.4em;
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--type-small);
  }

  @media (max-width: 809.98px) {
    .newsletter-card {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
