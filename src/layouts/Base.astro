---
import '../styles/global.css';
import '../styles/recent.css';
import '../styles/glass-interactions.css';
import '../styles/pattern-surfaces.css';
import { getCollection } from 'astro:content';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { href, issueHref, issueNo, sortIssues } from '../lib/mag';

type LayoutMode = 'reading' | 'listing' | 'article' | 'immersive';

interface Props {
  readonly title: string;
  readonly description?: string;
  readonly active?: string;
  readonly ogType?: 'website' | 'article';
  readonly layout?: LayoutMode;
  readonly home?: boolean;
}

const {
  title,
  description = '사람이 고르고 클로드가 엮는 AI 주간지, DADES 매거진.',
  active,
  ogType = 'website',
  layout = 'reading',
  home = false,
} = Astro.props;

// 디렉터리형 URL로 통일 — sitemap 표기와 캐노니컬을 일치시킨다
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);
const ogImage = new URL(href('/og.png'), Astro.site);

const [latestIssue] = sortIssues(await getCollection('issues'));
const latestIssueTo = latestIssue ? issueHref(latestIssue.data.number) : href('/');
const latestIssueLabel = latestIssue ? `Latest ${issueNo(latestIssue.data.number)}` : 'Latest issue';
const pageMode = home ? 'home' : layout;
const isContained = pageMode === 'reading';

const nav = [
  { key: 'home', label: '발행', to: href('/') }, { key: 'status', label: '상태판', to: href('/status/') },
  { key: 'wiki', label: '위키', to: href('/wiki/') }, { key: 'archive', label: 'Index', to: href('/archive/') },
  { key: 'about', label: '소개', to: href('/about/') }, { key: 'clippings', label: '스크랩북', to: href('/clippings/'), clipCount: true },
];
---

<!doctype html>
<html lang="ko" data-theme="paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — DADES 매거진</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="DADES 매거진" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="DADES 매거진"
      href={href('/rss.xml')}
    />
    <link rel="icon" type="image/png" href={href('/brand/dades-icon-192.png')} />
    <link rel="manifest" href={href('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={href('/brand/dades-apple-touch.png')} />
    <meta name="theme-color" content="#f2f1ec" />
    <!-- 조판은 Pretendard 한 벌뿐. 위계는 굵기·크기·자간·대소문자·색으로만 세운다. -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <script is:inline>
      (() => {
        document.documentElement.classList.add('has-reveal-js');
        try {
          let t = localStorage.getItem('dades:theme');
          if (t !== 'paper' && t !== 'white' && t !== 'ink') t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'ink' : 'paper';
          document.documentElement.setAttribute('data-theme', t);
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', { paper: '#f2f1ec', white: '#ffffff', ink: '#111315' }[t]);
        } catch {}
      })();
    </script>
  </head>
  <body class:list={['mode-root', `mode-${pageMode}`, { 'is-home': home }]} data-interaction-root>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>

    <SiteHeader
      active={active}
      nav={nav}
      latestIssueTo={latestIssueTo}
      latestIssueLabel={latestIssueLabel}
    />

    <main class:list={['page', `page-${pageMode}`, { container: isContained, 'page-home': home }]} id="main">
      <slot />
    </main>

    <SiteFooter latestIssueTo={latestIssueTo} latestIssueLabel={latestIssueLabel} />

    <script>
      // ---------- 모바일 내비게이션 ----------
      type ClipStore = Record<string, Record<string, unknown>>;
      const interactionRoot = document.querySelector<HTMLElement>('[data-interaction-root]');
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menuPanel = document.querySelector<HTMLElement>('[data-mobile-menu]');
      const menuLabel = { open: '메뉴 닫기', closed: '메뉴 열기' };
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      function setMenuOpen(open: boolean) {
        if (!menuToggle || !menuPanel) return;
        menuToggle.setAttribute('aria-expanded', String(open));
        menuToggle.setAttribute('aria-label', open ? menuLabel.open : menuLabel.closed);
        menuPanel.setAttribute('aria-hidden', String(!open));
        menuPanel.toggleAttribute('inert', !open);
        document.body.classList.toggle('menu-open', open);
        if (open) menuPanel.querySelector<HTMLAnchorElement>('[data-menu-first]')?.focus();
        else if (document.activeElement && menuPanel.contains(document.activeElement)) menuToggle.focus();
      }

      menuToggle?.addEventListener('click', () => setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true'));

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenuOpen(false);
      });

      document.addEventListener('click', (event) => {
        if (!document.body.classList.contains('menu-open')) return;
        if (event.target instanceof Node && !document.querySelector('.site-head')?.contains(event.target)) {
          setMenuOpen(false);
        }
      });

      window.matchMedia('(min-width: 810px)').addEventListener('change', (event) => {
        if (event.matches) setMenuOpen(false);
      });

      const updateScrollState = () => document.body.classList.toggle('is-scrolled', window.scrollY > 8);
      updateScrollState();
      window.addEventListener('scroll', updateScrollState, { passive: true });

      interactionRoot?.addEventListener('pointermove', (event) => {
        interactionRoot.style.setProperty('--pointer-x', `${event.clientX}px`);
        interactionRoot.style.setProperty('--pointer-y', `${event.clientY}px`);
      });

      const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (revealItems.length > 0) {
        if (reduceMotion.matches || !('IntersectionObserver' in window)) {
          revealItems.forEach((el) => el.classList.add('is-revealed'));
        } else {
          const revealObserver = new IntersectionObserver(
            (entries, observer) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              });
            },
            { rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
          );
          revealItems.forEach((el) => revealObserver.observe(el));
        }
      }

      // ---------- 테마 스위처 ----------
      const THEME_KEY = 'dades:theme';
      const swatches = document.querySelectorAll<HTMLButtonElement>('.theme-swatch');
      const THEME_BAR: Record<string, string> = { paper: '#f2f1ec', white: '#ffffff', ink: '#111315' };

      function applyTheme(theme: string) {
        document.documentElement.setAttribute('data-theme', theme);
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', THEME_BAR[theme]);
        swatches.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setTheme === theme)));
        try {
          localStorage.setItem(THEME_KEY, theme);
        } catch {}
      }

      swatches.forEach((b) => b.addEventListener('click', () => applyTheme(b.dataset.setTheme ?? 'paper')));
      // 초기 상태를 버튼에 반영
      const current = document.documentElement.getAttribute('data-theme') ?? 'paper';
      swatches.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setTheme === current)));

      // ---------- 클리핑 ----------
      const CLIP_KEY = 'dades:clips:v1';

      function readClips(): ClipStore {
        try {
          const parsed = JSON.parse(localStorage.getItem(CLIP_KEY) ?? '{}');
          // 손상된 저장값(문자열·배열·숫자 등)으로부터 클립 버튼을 보호한다
          if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) return parsed;
        } catch {}
        return {};
      }

      function writeClips(clips: ClipStore) {
        try {
          localStorage.setItem(CLIP_KEY, JSON.stringify(clips));
        } catch {}
        updateClipCount();
      }

      function updateClipCount() {
        const n = Object.keys(readClips()).length;
        document.querySelectorAll<HTMLElement>('[data-clip-count]').forEach((el) => { el.textContent = n > 0 ? `(${n})` : ''; });
      }

      // 클립 버튼·카운트를 저장소와 맞춘다 — 초기 로드, bfcache 복원, 다른 탭 변경 시
      function syncClipUi() {
        const clips = readClips();
        document.querySelectorAll<HTMLButtonElement>('.clip-btn[data-clip-id]').forEach((btn) => {
          const id = btn.dataset.clipId;
          if (!id) return;
          btn.setAttribute('aria-pressed', String(Boolean(clips[id])));
        });
        updateClipCount();
      }

      syncClipUi();
      window.addEventListener('pageshow', syncClipUi);
      window.addEventListener('storage', (e) => {
        if (e.key === CLIP_KEY || e.key === null) syncClipUi();
      });

      // ---------- 방문 기준선 ----------
      // "지난 방문 이후" 계산의 기준. 세션 안에서는 기준선을 고정해
      // 페이지를 오가도 홈의 방문 요약이 사라지지 않는다. (홈 스크립트와 같은 멱등 초기화)
      const SEEN_KEY = 'dades:last-seen';
      const BASELINE_KEY = 'dades:baseline';
      try {
        if (sessionStorage.getItem(BASELINE_KEY) === null) {
          sessionStorage.setItem(BASELINE_KEY, localStorage.getItem(SEEN_KEY) ?? '');
        }
        localStorage.setItem(SEEN_KEY, new Date().toISOString().slice(0, 10));
      } catch {}

      // ---------- 관심 태그 하이라이트 ----------
      const INTEREST_KEY = 'dades:interests:v1';

      function readInterests(): string[] {
        try {
          const parsed = JSON.parse(localStorage.getItem(INTEREST_KEY) ?? '[]');
          if (Array.isArray(parsed)) return parsed.filter((t) => typeof t === 'string');
        } catch {}
        return [];
      }

      const interests = new Set(readInterests());
      if (interests.size > 0) {
        document.querySelectorAll<HTMLElement>('.entry[data-tags]').forEach((entry) => {
          const tags = (entry.dataset.tags ?? '').split(',');
          if (tags.some((t) => interests.has(t))) entry.classList.add('is-interest');
        });
      }

      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.clip-btn[data-clip-id]');
        if (!btn) return;
        const id = btn.dataset.clipId;
        if (!id) return;
        const store = readClips();
        if (store[id]) {
          delete store[id];
          btn.setAttribute('aria-pressed', 'false');
        } else {
          let payload: Record<string, unknown> | null = null;
          try {
            const parsed = JSON.parse(btn.dataset.clipPayload ?? 'null');
            if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) payload = parsed;
          } catch {}
          if (!payload) return;
          store[id] = { ...payload, clippedAt: Date.now() };
          btn.setAttribute('aria-pressed', 'true');
        }
        writeClips(store);
      });
    </script>
  </body>
</html>
